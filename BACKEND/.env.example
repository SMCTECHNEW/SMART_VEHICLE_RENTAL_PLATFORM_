# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vehicle_rental

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Email/SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@smartvehicle.com

# SMS Provider (optional)
SMS_PROVIDER=  # twilio, msg91, or leave empty
SMS_API_KEY=
SMS_SENDER_ID=

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Password Reset Token Expiry (minutes)
PASSWORD_RESET_TOKEN_EXPIRY=60
